# Model-serving image: versions pinned to match the registered model's requirements.txt.
# If you retrain with different library versions, update these pins to match.
FROM python:3.12-slim
RUN pip install --no-cache-dir \
    "mlflow==3.18.0" "scikit-learn==1.9.1" "numpy==2.5.4" "pandas==2.3.3" \
    "scipy==1.18.1" "skops==0.16.0" "psutil==7.2.2"
WORKDIR /srv
